  "initialized_from": "analysis",
  "src_dir": "server-go/",
  "version_file": "server-go/config.json",
  "stack": {
    "backend": {
      "language": "go",
      "framework": null
    },
    "frontend": {
      "language": "javascript",
      "framework": "react"
    },
    "mobile": null,
    "firmware": {
      "platform": "esp32-c3",
      "framework": "platformio"
    },
    "database": null
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "local-windows-binary (meme poste, pas de ssh distant)"
        },
        "access": {
          "method": "handoff",
          "host": "",
          "runtime": "windows-binary",
          "port": 9090,
          "target_dir": "build/qualif_v{X.Y.Z}/",
          "credentials_env": [],
          "verified": {
            "status": "ok",
            "at": "2026-11-24T00:00:00Z",
            "checks": [
              "target-dir (build/qualif_v<X.Y.Z>/ writable) : ok (rejoue 2026-11-24)",
              "toolchain (go1.26.11, node v22.23.3, pio) : ok",
              "livraison = exe Windows remis a l utilisateur (lancement et smoke tests cote utilisateur, port 9090 non sonde depuis le conteneur — hors perimetre du jalon)"
            ]
          }
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "none",
          "target": "aucune plateforme geree par deployer — installation manuelle utilisateur depuis la GitHub Release"
        },
        "access": {
          "method": "github-release",
          "repo": "CCoupel/BuzzMaster",
          "credentials_env": [],
          "verified": {
            "status": "ok",
            "at": "2026-11-12T08:18:29Z",
            "checks": [
              "gh-auth (CCoupel via GH_TOKEN, scopes repo+workflow) : ok",
              "repo-push (gh api permissions.push=true) : ok",
              "pipeline (.github/workflows/release.yml + ci-branch.yml presents, actifs, declencheur tags v*) : ok",
              "tag v11.7.0 / Release v11.7.0 : absents (attendu avant PUBLISH PROD)",
              "branche main : sans protection ni ruleset (push direct possible)"
            ]
          }
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "go-test"
    ],
    "frontend": [
      "vitest"
    ],
    "e2e": [
      "manual"
    ],
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50,
    "perf": {
      "picto_relay": {
        "p95_ms": 100,
        "frame_max_bytes": 4096,
        "canvas_max_points": 60000,
        "nominal": {
          "frames_per_s": 16,
          "points_per_frame": 8,
          "duration_s": 280,
          "disconnects_max": 0,
          "frames_lost_max": 0
        },
        "max_frame": {
          "frames_per_s": 16,
          "points_per_frame": 200,
          "duration_s": 15,
          "disconnects_max": 0,
          "frames_lost_max": 0
        },
        "x3": {
          "frames_per_s": 48,
          "points_per_frame": 200,
          "duration_s": 60,
          "disconnects_max": 0,
          "losses_tolerated": true,
          "canvas_full_tolerated": true
        },
        "source": "tests/perf/picto-load.md"
      }
    }
  },
  "security": {
    "concerns": []
  },
  "commands": {
    "build": "cd server-go && go build ./cmd/server",
    "test": "cd server-go && go test ./...",
    "lint": "cd server-go && go vet ./...",
    "audit": "cd server-go && govulncheck ./... && (cd web && npm audit --audit-level=high)",
    "typecheck": "",
    "coverage": "cd server-go && go test ./... -coverprofile=coverage.out && go tool cover -html=coverage.out",
    "ci": "scripts/ci.sh",
    "test_related": "cd server-go/web && npx vitest related --run {FILES}",
    "env": "export PATH=$HOME/.local/bin:$HOME/go/bin:$PATH GOTOOLCHAIN=go1.26.11",
    "test_targeted": "cd server-go && go test {TARGETS}"
  },
  "extended_commands": {
    "repo_url": "https://github.com/CCoupel/BuzzMaster",
    "src_dir": "server-go/",
    "version_file": "server-go/config.json",
    "build_validate": "ls -la server-go/server 2>/dev/null || echo 'Binary not found'",
    "server_stop": "curl -s http://localhost/shutdown",
    "server_restart": "curl -s http://localhost/shutdown && sleep 2 && cd server-go && ./server",
    "server_verify": "curl -s http://localhost/api/version",
    "coverage": "cd server-go && go test ./... -coverprofile=coverage.out && go tool cover -html=coverage.out",
    "version_read": "cat server-go/config.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(d['version'])\""
  },
