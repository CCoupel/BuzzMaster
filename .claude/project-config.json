{
  "name": "BuzzControl",
  "team_name": "TEAM-Buzz",
  "org": "CCoupel",
  "project": "BuzzMaster",
  "description": "Système de buzzers sans fil pour jeux de quiz — serveur Go + frontend React + firmware ESP32-C3",
  "version": "11.2.3",
  "initialized_at": "2026-04-28",
  "initialized_from": "analysis",
  "src_dir": "server-go/",
  "version_file": "server-go/config.json",
  "stack": {
    "backend": {
      "language": "go",
      "framework": null
    },
    "frontend": {
      "language": "javascript",
      "framework": "react"
    },
    "mobile": null,
    "firmware": {
      "platform": "esp32-c3",
      "framework": "platformio"
    },
    "database": null
  },
  "infrastructure": {
    "cicd": "github-actions",
    "environments": [
      {
        "name": "QUALIF",
        "order": 1,
        "publish": {
          "mode": "promote",
          "target": "build/qualif_v{X.Y.Z}/"
        },
        "deploy": {
          "mechanism": "vps",
          "target": "local-windows-binary (meme poste, pas de ssh distant)"
        }
      },
      {
        "name": "PROD",
        "order": 2,
        "publish": {
          "mode": "rebuild-ci",
          "trigger": "git-tag",
          "pipeline": ".github/workflows/release.yml"
        },
        "deploy": {
          "mechanism": "none",
          "target": "aucune plateforme geree par deployer — installation manuelle utilisateur depuis la GitHub Release"
        }
      }
    ]
  },
  "testing": {
    "backend": [
      "go-test"
    ],
    "frontend": [
      "vitest"
    ],
    "e2e": [
      "manual"
    ],
    "regression_at_qa": "gated",
    "full_regression_at": "qualif",
    "coverage_min": 70,
    "lot_max_tests": 50
  },
  "security": {
    "concerns": []
  },
  "commands": {
    "build": "cd server-go && go build ./cmd/server",
    "test": "cd server-go && go test ./...",
    "lint": "cd server-go && go vet ./...",
    "audit": "cd server-go && govulncheck ./... && (cd web && npm audit --audit-level=high)",
    "typecheck": "",
    "coverage": "cd server-go && go test ./... -coverprofile=coverage.out && go tool cover -html=coverage.out",
    "ci": "scripts/ci.sh"
  },
  "extended_commands": {
    "repo_url": "https://github.com/CCoupel/BuzzMaster",
    "src_dir": "server-go/",
    "version_file": "server-go/config.json",
    "build_validate": "ls -la server-go/server 2>/dev/null || echo 'Binary not found'",
    "server_stop": "curl -s http://localhost/shutdown",
    "server_restart": "curl -s http://localhost/shutdown && sleep 2 && cd server-go && ./server",
    "server_verify": "curl -s http://localhost/api/version",
    "coverage": "cd server-go && go test ./... -coverprofile=coverage.out && go tool cover -html=coverage.out",
    "version_read": "cat server-go/config.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(d['version'])\""
  },
  "template_version": {
    "tag": "v3.23.0",
    "commit": "4b264a0ad923985013b16cfffd4de1070cf18db9"
  },
  "docs": {
